# Streamlit Secrets - DO NOT COMMIT THE ACTUAL secrets.toml FILE
# Copy this file to secrets.toml and fill in your values:
#   cp secrets.toml.example secrets.toml

# =============================================================================
# Database Connection - REQUIRED
# =============================================================================
# Uncomment ONE of the following DATABASE_URL options:

# Option 1: Local PostgreSQL (for local development)
#DATABASE_URL = "postgresql://localhost:5432/patient_twin"

# Option 2: Supabase (hosted PostgreSQL)
# Get your connection string from: Supabase Dashboard > Settings > Database > Connection string
#DATABASE_URL = "postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres"

# Option 3: Neon (serverless PostgreSQL — recommended)
# Get your connection string from: Neon Console > Connection Details
DATABASE_URL = "postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# Auth Cookie Settings
# =============================================================================
[auth]
cookie_name = "patient_twin_auth"
cookie_key = "change-this-to-a-random-secret-key-in-production"  # Change this!
cookie_expiry_days = 30

# =============================================================================
# User Credentials
# =============================================================================
# Passwords are hashed with bcrypt. To generate a hashed password, run:
#   python -c "import bcrypt; print(bcrypt.hashpw('yourpassword'.encode(), bcrypt.gensalt()).decode())"

[credentials]

[credentials.usernames]

[credentials.usernames.admin]
name = "Administrator"
email = "admin@example.com"
password = "$2b$12$REPLACE_WITH_BCRYPT_HASH"
role = "doctor"

[credentials.usernames.doctor]
name = "Dr. Smith"
email = "doctor@hospital.com"
password = "$2b$12$REPLACE_WITH_BCRYPT_HASH"
role = "doctor"

[credentials.usernames.patient]
name = "Demo Patient"
email = "patient@example.com"
password = "$2b$12$REPLACE_WITH_BCRYPT_HASH"
role = "patient"
