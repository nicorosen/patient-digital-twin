# Patient Digital Twin - Environment Configuration
# Copy this file to .env and fill in your values
#
# NOTE: You can also set LLM provider via command line:
#   python run.py --llm google --model gemini-2.5-pro
#   python run.py --llm anthropic --model claude-sonnet-4-20250514
#   python run.py --llm openai --model gpt-4o

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# LLM Provider: anthropic | openai | google (default: google)
LLM_PROVIDER=google

# API Keys (only the key for your selected provider is required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# Model name (provider-specific, default: gemini-2.5-pro)
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514
# OpenAI: gpt-4o, gpt-4-turbo, gpt-4o-mini
# Google: gemini-2.5-pro (default), gemini-2.0-flash, gemini-1.5-pro
MODEL_NAME=gemini-2.5-pro

# Max tokens for LLM responses
MAX_TOKENS=4096

# =============================================================================
# Database Configuration
# =============================================================================
# Uncomment ONE of the following DATABASE_URL options:

# Option 1: Local PostgreSQL (for local development)
#DATABASE_URL=postgresql://localhost:5432/patient_twin

# Option 2: Supabase (hosted PostgreSQL)
# Get your connection string from: Supabase Dashboard > Settings > Database > Connection string
# Note: SQLAlchemy requires "postgresql://" prefix; Supabase may provide "postgres://" which is auto-converted.
# You can also set SUPABASE_PROJECT_URL, SUPABASE_PUBLISHABLE_KEY, and SUPABASE_SECRET_KEY if using Supabase Auth.
#DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres
#SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
#SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#SUPABASE_SECRET_KEY=eyJ...

# Option 3: Neon (serverless PostgreSQL — recommended)
# Get your connection string from: Neon Console > Connection Details
# Neon provides connection pooling and serverless scaling out of the box.
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# Vector Database (Chroma) Configuration
# =============================================================================

CHROMA_PERSIST_DIR=./data/embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# Application Settings
# =============================================================================

LOG_LEVEL=INFO
ENVIRONMENT=development
