# Patient Digital Twin - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://localhost:5432/patient_twin

# =============================================================================
# LLM / ANTHROPIC
# =============================================================================
# Your Anthropic API key (required)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Model to use for agents (default: claude-sonnet-4-20250514)
MODEL_NAME=claude-sonnet-4-20250514

# =============================================================================
# VECTOR DATABASE (CHROMA)
# =============================================================================
# Directory to persist Chroma embeddings
CHROMA_PERSIST_DIR=./data/embeddings

# Embedding model for semantic search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# APPLICATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development, production
ENVIRONMENT=development
